{
  "name": "ta-assignment-mvp",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "db:up": "node scripts/start-db.mjs",
    "db:down": "docker compose down",
    "db:migrate": "node scripts/migrate.mjs",
    "db:migrate-fs": "node scripts/migrate-fs-to-db.mjs",
    "audio:gc": "node scripts/audio-gc.mjs",
    "analyze:authorship": "node scripts/detect-ai-answers.mjs",
    "test:audio": "node tests/audio-e2e/run.mjs",
    "test:ab-orchestrator": "node -r dotenv/config tests/ab-orchestrator/run.mjs",
    "test:chat-dedup": "node --test tests/chat-dedup.test.mjs",
    "bench": "node scripts/bench-run.mjs",
    "bench:validate": "node scripts/bench-run.mjs --dry-run",
    "bench:export": "node scripts/bench-export.mjs",
    "bench:import": "node scripts/bench-import.mjs",
    "test:benchmark": "node --test tests/benchmark.test.mjs",
    "test:json-extract": "node --test tests/json-extract.test.mjs",
    "test:auth-policy": "node --test -r dotenv/config tests/auth-policy-inheritance.test.mjs",
    "test:cost-audit": "node --test tests/cost-audit.test.mjs",
    "benchmark:work": "node -r dotenv/config scripts/create-benchmark-work.mjs",
    "predev": "npm run db:up && npm run db:migrate",
    "dev": "node server.js"
  },
  "dependencies": {
    "@replit/object-storage": "^1.0.0",
    "bcrypt": "^6.0.0",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.2",
    "express-session": "^1.19.0",
    "helmet": "^8.2.0",
    "js-yaml": "^4.1.1",
    "multer": "^2.2.0",
    "music-metadata": "^11.12.3",
    "onnxruntime-node": "^1.27.0",
    "openai": "^6.17.0",
    "pdfkit": "^0.19.1",
    "pg": "^8.20.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "playwright-core": "^1.60.0"
  }
}
