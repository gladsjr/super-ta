# ORATIA — variáveis de ambiente (desenvolvimento local)
#
# Copie este arquivo para `.env` (que está no .gitignore) e preencha os valores.
# Todo entrypoint do projeto carrega isto via `import "dotenv/config"`:
# server.js, scripts/*.mjs e o harness tests/audio-e2e/run.mjs. Logo, qualquer
# comando rodado (inclusive pelo Claude Code) já enxerga estas variáveis.

# --- Obrigatórias ---

# Chave da OpenAI. O sistema chama Responses/Files/VectorStores/STT/TTS a cada
# turno; sem isto nada de entrevista funciona. NUNCA versione a chave real.
OPENAI_API_KEY=sk-cole-sua-chave-aqui

# Postgres local (bate com o docker-compose.yml: usuário/senha/db = superta).
DATABASE_URL=postgres://superta:superta@localhost:5432/superta

# Segredo da sessão Express. Em dev pode ser qualquer string; troque em prod.
SESSION_SECRET=dev-oratia-local-secret-change-me

# Usuários semeados no boot (seedInitialUsers). Formato: usuario:senha,usuario2:senha2
INITIAL_USERS=professor:senha123,admin:admin123

# --- Opcionais (têm default sensato fora do Replit) ---

# Porta do servidor.
PORT=5099

# Nível de log: error | warn | info | debug | prompt
LOG_LEVEL=info

NODE_ENV=development

# Armazenamento do áudio do aluno. Fora do Replit o default já é "local"
# (REPL_ID ausente). Descomente para forçar explicitamente.
# AUDIO_STORE_BACKEND=local
# AUDIO_STORE_LOCAL_DIR=.audio-store
